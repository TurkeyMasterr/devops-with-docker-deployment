# BACKEND
FROM golang:1.25-alpine AS builder

WORKDIR /usr/src/app
COPY code/example-backend .
RUN CGO_ENABLED=0 go build -o server \
&& go test ./...

##
FROM scratch

WORKDIR /usr/src/app
COPY --from=builder /usr/src/app/server ./server
# The allowed port from which the backend receives requests from
ENV REQUEST_ORIGIN=http://localhost:5001
USER 1000
EXPOSE 8080
CMD ["./server"]


